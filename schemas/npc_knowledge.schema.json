{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GODSEED actor knowledge packet (proposal v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "world_id",
    "actor_id",
    "as_of_tick",
    "revision",
    "observations",
    "beliefs",
    "memories"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.1-proposal"
      ]
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "as_of_tick": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "receipt_id",
          "acquired_tick",
          "channel",
          "claims",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "receipt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "acquired_tick": {
            "type": "integer",
            "minimum": 0
          },
          "channel": {
            "type": "string",
            "enum": [
              "direct",
              "report",
              "record",
              "internal"
            ]
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "beliefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim_key",
          "interpretation",
          "status",
          "support_ids",
          "contradict_ids",
          "revision",
          "updated_tick"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "claim_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "interpretation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "enum": [
              "tentative",
              "supported",
              "contested",
              "withdrawn"
            ]
          },
          "support_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true
          },
          "contradict_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "updated_tick": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "observation_ids",
          "summary",
          "salience",
          "acquired_tick",
          "last_recalled_tick"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "salience": {
            "type": "string",
            "enum": [
              "routine",
              "important",
              "critical"
            ]
          },
          "acquired_tick": {
            "type": "integer",
            "minimum": 0
          },
          "last_recalled_tick": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
