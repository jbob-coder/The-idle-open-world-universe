  "unit": "Reference whole CR only. Proposed conversion to minor units requires currency contract review.",
  "notes": [
    "Accounting household reference does not establish legal ownership or family composition.",
    "Reference account IDs and distinct lot IDs are proposed, not registered. Actual ownership, authorization and endowment provenance must be accepted before posting.",
    "Opening funding is an explicit one-time initialization boundary source, not wage or revenue. Do not also post reserve or cash as a transfer from an invented payer.",
    "All weekly inflow, cost and net values are projections only. No automatic source or sink, rent transfer, wage credit, stock or service promise.",
    "Unknown actual obligations and asset balances remain null/unresolved. Do not interpret as zero or activate the profile.",
    "Unemployed reference has no employer agreement; no automatic wage or welfare."
  ],
  "initialization_contract_proposal": {
    "authority": "01 world registration/transaction with 02 reviewed ownership, provenance and domain initialization",
    "identity": "Stable logical opening endowment key per world and reviewed account; bind canonical original payload; exact technical retry returns original receipt; conflicting retry rejected. Epoch is not a reason to mint again. Explicit new-world initialization only; recovery restores existing ledger, rewind restores snapshot rather than reposting. Any approved initial endowment missing from a snapshot is a validation failure, not a new funding trigger.",
    "commit": "Validate complete reviewed account ownership, opening amounts, lot origin, affected domain registration and unique initialization markers in one stage. Commit accounts, provenance, initialization receipts and all domain state atomically. No public receipt exposes another actor's finances.",
    "unresolved": [
      "currency denomination and terminal fractional wage policy",
      "authorized account owners and beneficiaries",
      "actual rental agreements and payees",
      "employment agreement acceptance and compensable evidence",
      "stock lots and ownership, prices, suppliers and funded counterparties",
      "actual assets/liabilities, historical obligations and prehistory",
      "opening timestamp and epoch snapshot schema"
    ]
  },
